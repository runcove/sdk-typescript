{
  "name": "@runcove/sdk",
  "version": "0.5.0",
  "description": "TypeScript SDK for the Cove external REST API (bearer key or Warpgate ticket auth)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runcove/sdk-typescript.git"
  },
  "homepage": "https://github.com/runcove/sdk-typescript#readme",
  "bugs": {
    "url": "https://github.com/runcove/sdk-typescript/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": ["dist", "LICENSE"],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + '\\n')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "npm run build:esm && tsc -p tsconfig.examples.json",
    "typecheck:tests": "tsc -p tsconfig.typetests.json",
    "generate": "node scripts/generate.mjs",
    "check:browser": "node scripts/check-browser-bundle.mjs",
    "test": "npm run build && npm run typecheck:tests && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@flue/runtime": "2.1.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "26.6.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  }
}
